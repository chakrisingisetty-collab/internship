774 0 obj
  << /ActualText (03 \024 Before \046 After \024 SnapBook UI Audit\nImproving colour usage and accessibility in the mobile interface\056\nBefore \050Issues\051\n\025 Low contrast text\050 \025 Inconsistent colours\050 \025 Colour used without icons\050 \025 Unclear button states\050 \025 Important information hard to read\nAfter \050Improved\051\n\023 Better contrast and readability\050 \023 Consistent colour system\050 \023 Colour combined with icons\057text\050 \023 Clear and accessible button states\050 \023 Important information stands out)
     /K [ 18 ]
     /P 775 0 R
     /Pg 738 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

775 0 obj
  << /K [ 774 0 R ]
     /P 794 0 R
     /S /P
     /Pg 738 0 R
     /Type /StructElem
  >>
endobj

776 0 obj
  << /ActualText (04 \024 Accessibility Checklist\nUse this checklist to ensure your design is inclusive\056\n\023 Text has sufficient contrast against the background\056\n\023 Important information is not communicated by colour alone\056\n\023 Error states include icons and text \050not only red colour\051\056\n\023 Success states include icons and text \050not only green colour\051\056\n\023 Colours are distinguishable for users with colour vision deficiencies\056\n\023 Buttons and interactive elements are clearly distinguishable\056\n\023 Text is readable on mobile screens \050different lighting conditions\051\056\n\023 Colour usage is consistent across all screens\056)
     /K [ 19 ]
     /P 777 0 R
     /Pg 738 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

